# ── Database (already set if MongoDB is running) ───────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=adltrack

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend URL (used in email links) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (team invitations, password resets, package notices) ─────────────
# Set ONE of these. Gmail/SMTP is not used (Render's free plan blocks SMTP).
#   Resend: resend.com → API Keys. Needs a verified domain to email other people.
#   Brevo:  brevo.com → SMTP & API → API Keys. Works with one verified sender address.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender shown on emails. Must be a verified domain (Resend) or verified sender (Brevo).
EMAIL_FROM=Noted <hello@yourdomain.com>

# ── Assistant (optional) ───────────────────────────────────────────────────
# With a key, free-form questions go to a small Claude model. Without one the
# assistant still works from its built-in rules (logging, finding, navigation).
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
